digraph G { graph [bgcolor="transparent",margin=0,pad=0.03]; node [fontname="Liberation Mono",fontsize=12,shape=plain]; cl [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a98b1" BGCOLOR="#fafcff"><TR><TD BGCOLOR="#eaf0ff" CELLPADDING="11"><FONT FACE="Liberation Mono" POINT-SIZE="16"><B>Teglalap</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ x : double</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ y : double</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ szelesseg : double</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ magassag : double</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ kerulet() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ terulet() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ atfed(other: Teglalap) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ siknegyed() : int</FONT></TD></TR></TABLE>>]; }