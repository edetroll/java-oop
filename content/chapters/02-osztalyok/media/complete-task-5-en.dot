digraph UML {
graph [rankdir=BT,bgcolor="transparent",pad="0.15",nodesep="0.3",ranksep="0.6",splines=polyline];
node [shape=plain];
edge [color="#6a819c",penwidth=1.4,arrowsize=0.9];
"Movie" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#90a5c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14"><B>Movie</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ director : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ title : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ duration : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ language : Language</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ subtitles : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ actor1 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ actor2 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ actor3 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ category : String</FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ hasActor(name : String) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ toString() : String</FONT></TD></TR></TABLE>>];
}