digraph G { graph [bgcolor="transparent",margin=0,pad=0.03]; node [shape=plain]; cl [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a98b1" BGCOLOR="#fafcff"><TR><TD BGCOLOR="#eaf0ff" CELLPADDING="11"><FONT FACE="Arial" POINT-SIZE="18"><B>Rectangle</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ x : double</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ y : double</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ width : double</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ height : double</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ perimeter() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ area() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ overlaps(other : Rectangle) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ quadrant() : int</FONT></TD></TR></TABLE>>]; }