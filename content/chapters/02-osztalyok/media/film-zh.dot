digraph G { graph [bgcolor="transparent",margin=0,pad=0.03]; node [fontname="Liberation Mono",fontsize=12,shape=plain]; cl [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a98b1" BGCOLOR="#fafcff"><TR><TD BGCOLOR="#eaf0ff" CELLPADDING="11"><FONT FACE="Liberation Mono" POINT-SIZE="16"><B>电影</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 导演 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 片名 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 演员1 / 2 / 3 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 时长 : int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 类别 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 语言 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 有字幕 : boolean</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 有演员(姓名 : String) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ toString() : String</FONT></TD></TR></TABLE>>]; }