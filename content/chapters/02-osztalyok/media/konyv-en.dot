digraph G { graph [bgcolor="transparent",margin=0,pad=0.03]; node [fontname="Liberation Mono",fontsize=12,shape=plain]; cl [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a98b1" BGCOLOR="#fafcff"><TR><TD BGCOLOR="#eaf0ff" CELLPADDING="11"><FONT FACE="Liberation Mono" POINT-SIZE="16"><B>Book</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ author : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ title : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ price : int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ genre : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ printed : boolean</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ applyDiscount(percent : int) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ toString() : String</FONT></TD></TR></TABLE>>]; }