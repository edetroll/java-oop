digraph G { graph [bgcolor="transparent",margin=0,pad=0.03]; node [shape=plain]; cl [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a98b1" BGCOLOR="#fafcff"><TR><TD BGCOLOR="#eaf0ff" CELLPADDING="11"><FONT FACE="Arial" POINT-SIZE="18"><B>Film</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ director : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ title : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ actor1 / 2 / 3 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ duration : int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ category : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ language : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ subtitled : boolean</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ featuresActor(name : String) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ toString() : String</FONT></TD></TR></TABLE>>]; }