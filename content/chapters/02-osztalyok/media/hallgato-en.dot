digraph G { graph [bgcolor="transparent",margin=0,pad=0.03]; node [shape=plain]; cl [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a98b1" BGCOLOR="#fafcff"><TR><TD BGCOLOR="#eaf0ff" CELLPADDING="11"><FONT FACE="Arial" POINT-SIZE="18"><B>Student</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ name : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ studentId : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ dateOfBirth : LocalDate</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ register(course : String) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ withdraw(course : String) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ canTakeFinalExam() : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="monospace" POINT-SIZE="12">+ toString() : String</FONT></TD></TR></TABLE>>]; }