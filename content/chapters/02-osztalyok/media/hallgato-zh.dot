digraph G { graph [bgcolor="transparent",margin=0,pad=0.03]; node [fontname="Liberation Mono",fontsize=12,shape=plain]; cl [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a98b1" BGCOLOR="#fafcff"><TR><TD BGCOLOR="#eaf0ff" CELLPADDING="11"><FONT FACE="Liberation Mono" POINT-SIZE="16"><B>学生</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 姓名 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 学号 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 出生日期 : LocalDate</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 选课(课程 : String) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 退课(课程 : String) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 可参加毕业考试() : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ toString() : String</FONT></TD></TR></TABLE>>]; }