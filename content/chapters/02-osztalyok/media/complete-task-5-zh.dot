digraph UML {
graph [rankdir=BT,bgcolor="transparent",pad="0.15",nodesep="0.3",ranksep="0.6",splines=polyline];
node [shape=plain];
edge [color="#6a819c",penwidth=1.4,arrowsize=0.9];
"电影" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#90a5c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="14"><B>电影</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 导演 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 标题 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 时长 : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 语言 : 语言</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 字幕 : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 演员一 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 演员二 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 演员三 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ category : String</FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 是否有演员(姓名 : String) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ toString() : String</FONT></TD></TR></TABLE>>];
}