digraph UML {
graph [rankdir=BT,bgcolor="transparent",pad="0.15",nodesep="0.3",ranksep="0.6",splines=polyline];
node [shape=plain];
edge [color="#6a819c",penwidth=1.4,arrowsize=0.9];
"银行账户" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#90a5c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="14"><B>银行账户</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- owner : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- accountNumber : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- balance : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 银行账户(owner : String, accountNumber : String, balance : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 银行账户(owner : String, accountNumber : String)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+getOwner() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+setOwner(owner : String) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+getAccountNumber() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+getBalance() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ deposit(amount : int) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ withdraw(amount : int) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ getBalance() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ toString() : String</FONT></TD></TR></TABLE>>];
"银行" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#90a5c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="14"><B>银行</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- 账户列表 : ArrayList&lt;银行账户&gt;</FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 银行()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取数量() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取账户(索引 : int) : 银行账户</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 添加账户(账户对象 : 银行账户) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 筛选高余额账户(amount : int) : ArrayList&lt;银行账户&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取总余额() : int</FONT></TD></TR></TABLE>>];
"银行账户" -> "银行" [dir=none,label="0..*",fontname="Noto Sans CJK SC",fontsize=10];
}