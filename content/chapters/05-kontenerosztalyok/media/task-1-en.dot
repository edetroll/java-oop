digraph UML {
graph [rankdir=BT,bgcolor="transparent",pad="0.15",nodesep="0.3",ranksep="0.6",splines=polyline];
node [shape=plain];
edge [color="#6a819c",penwidth=1.4,arrowsize=0.9];
"Rectangle" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#90a5c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14"><B>Rectangle</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- x : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- y : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- width : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- height : double</FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ Rectangle()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ Rectangle(x : double, y : double, width : double, height : double)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+getX() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+setX(x : double) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+getY() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+setY(y : double) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+getWidth() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+setWidth(width : double) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+getHeight() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+setHeight(height : double) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ getPerimeter() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ getArea() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ overlaps(other : Rectangle) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ getQuadrant() : int</FONT></TD></TR></TABLE>>];
"RectangleCollection" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#90a5c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14"><B>RectangleCollection</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- rectangles : ArrayList&lt;Rectangle&gt;</FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ RectangleCollection()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ getCount() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ getRectangle(index : int) : Rectangle</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ addRectangle(rectangle : Rectangle) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ getLargeRectangles(minArea : double) : ArrayList&lt;Rectangle&gt;</FONT></TD></TR></TABLE>>];
"Rectangle" -> "RectangleCollection" [dir=none,label="0..*",fontname="DejaVu Sans Mono",fontsize=10];
}