digraph UML {
graph [rankdir=BT, bgcolor="transparent",pad="0.12",nodesep="0.4",ranksep="0.65",splines=polyline];
node [shape=plain];
edge [color="#64748b",penwidth=1.5, arrowsize=0.9];
"Person" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#8ba3c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e7efff" CELLPADDING="10"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="15"><B>Person</B></FONT></TD></TR><TR><TD BGCOLOR="#dfe6f1" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#27364c">- name : String</FONT></TD></TR><TR><TD BGCOLOR="#dfe6f1" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#27364c">+ Person(name : String)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#27364c">+ getName() : String</FONT></TD></TR></TABLE>>];
"Family" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#8ba3c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e7efff" CELLPADDING="10"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="15"><B>Family</B></FONT></TD></TR><TR><TD BGCOLOR="#dfe6f1" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#27364c">- members : ArrayList&lt;Person&gt;</FONT></TD></TR><TR><TD BGCOLOR="#dfe6f1" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#27364c">+ Family()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#27364c">+ getMemberCount() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#27364c">+ getMember(index : int) : Person</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#27364c">+ addMember(person : Person) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#27364c">+ removeMember(name : String) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11" COLOR="#27364c">+ findByPrefix(prefix : String) : ArrayList&lt;Person&gt;</FONT></TD></TR></TABLE>>];
"Person" -> "Family" [dir=none, label="0..*",fontsize=10,fontname="DejaVu Sans Mono"];
}