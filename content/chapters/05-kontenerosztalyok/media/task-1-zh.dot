digraph UML {
graph [rankdir=BT,bgcolor="transparent",pad="0.15",nodesep="0.3",ranksep="0.6",splines=polyline];
node [shape=plain];
edge [color="#6a819c",penwidth=1.4,arrowsize=0.9];
"矩形" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#90a5c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="14"><B>矩形</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- x : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- y : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- 宽度 : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- 高度 : double</FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 矩形()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 矩形(x : double, y : double, 宽度 : double, 高度 : double)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+获取X() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+设置X(x : double) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+获取Y() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+设置Y(y : double) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+获取宽度() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+设置宽度(宽度 : double) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+获取高度() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+设置高度(高度 : double) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取周长() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取面积() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 是否相交(其他对象 : 矩形) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取象限() : int</FONT></TD></TR></TABLE>>];
"矩形集合" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#90a5c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="14"><B>矩形集合</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- 矩形列表 : ArrayList&lt;矩形&gt;</FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 矩形集合()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取数量() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取矩形(索引 : int) : 矩形</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 添加矩形(矩形对象 : 矩形) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 筛选大面积矩形(最小面积 : double) : ArrayList&lt;矩形&gt;</FONT></TD></TR></TABLE>>];
"矩形" -> "矩形集合" [dir=none,label="0..*",fontname="Noto Sans CJK SC",fontsize=10];
}