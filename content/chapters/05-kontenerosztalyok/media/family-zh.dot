digraph UML {
graph [rankdir=BT, bgcolor="transparent",pad="0.12",nodesep="0.4",ranksep="0.65",splines=polyline];
node [shape=plain];
edge [color="#64748b",penwidth=1.5, arrowsize=0.9];
"人物" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#8ba3c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e7efff" CELLPADDING="10"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="15"><B>人物</B></FONT></TD></TR><TR><TD BGCOLOR="#dfe6f1" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="11" COLOR="#27364c">- 姓名 : String</FONT></TD></TR><TR><TD BGCOLOR="#dfe6f1" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="11" COLOR="#27364c">+ 人物(姓名 : String)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="11" COLOR="#27364c">+ 获取姓名() : String</FONT></TD></TR></TABLE>>];
"家庭" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#8ba3c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e7efff" CELLPADDING="10"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="15"><B>家庭</B></FONT></TD></TR><TR><TD BGCOLOR="#dfe6f1" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="11" COLOR="#27364c">- 成员列表 : ArrayList&lt;人物&gt;</FONT></TD></TR><TR><TD BGCOLOR="#dfe6f1" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="11" COLOR="#27364c">+ 家庭()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="11" COLOR="#27364c">+ 获取成员数量() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="11" COLOR="#27364c">+ 获取成员(索引 : int) : 人物</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="11" COLOR="#27364c">+ 添加成员(person : 人物) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="11" COLOR="#27364c">+ 删除成员(姓名 : String) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="6"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="11" COLOR="#27364c">+ 按前缀查找(prefix : String) : ArrayList&lt;人物&gt;</FONT></TD></TR></TABLE>>];
"人物" -> "家庭" [dir=none, label="0..*",fontsize=10,fontname="Noto Sans CJK SC"];
}