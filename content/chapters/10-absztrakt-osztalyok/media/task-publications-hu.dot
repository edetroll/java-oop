digraph UML { graph [rankdir=TB,bgcolor="transparent",pad="0.12",nodesep="0.36",ranksep="0.7",splines=polyline];
node [shape=plain]; edge [color="#687d9a",penwidth=1.45,arrowsize=0.85];
"Publication" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">&lt;&lt;abstract&gt;&gt;<BR/><I>Publication</I></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- title : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- basePrice : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ Publication(title : String, basePrice : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ getTitle() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ getBasePrice() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c"><I>+ calculateShippingCost() : int</I></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ getTotalPrice() : int</FONT></TD></TR></TABLE>>];
"Textbook" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13"><B>Textbook</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- pageCount : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ Textbook(title : String, basePrice : int, pageCount : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ calculateShippingCost() : int</FONT></TD></TR></TABLE>>];
"Magazine" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13"><B>Magazine</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- issueNumber : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ Magazine(title : String, basePrice : int, issueNumber : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ calculateShippingCost() : int</FONT></TD></TR></TABLE>>];
"Textbook" -> "Publication" [arrowhead=empty];
"Magazine" -> "Publication" [arrowhead=empty];
}
