digraph UML { graph [rankdir=TB,bgcolor="transparent",pad="0.12",nodesep="0.36",ranksep="0.7",splines=polyline];
node [shape=plain]; edge [color="#687d9a",penwidth=1.45,arrowsize=0.85];
"影视作品" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13">&lt;&lt;抽象&gt;&gt;<BR/><I>影视作品</I></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 标题 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 发行年份 : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 影视作品(标题 : String, 发行年份 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取标题() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取发行年份() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c"><I>+ 获取总时长() : int</I></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 可在时间内观看(可用分钟 : int) : boolean</FONT></TD></TR></TABLE>>];
"电影" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13"><B>电影</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 时长 : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 电影(标题 : String, 发行年份 : int, 时长 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取总时长() : int</FONT></TD></TR></TABLE>>];
"剧集" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13"><B>剧集</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 集数 : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 平均每集时长 : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 剧集(标题 : String, 发行年份 : int,<BR ALIGN="LEFT"/>    集数 : int, 平均每集时长 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取总时长() : int</FONT></TD></TR></TABLE>>];
"电影" -> "影视作品" [arrowhead=empty];
"剧集" -> "影视作品" [arrowhead=empty];
}
