digraph UML { graph [rankdir=TB,bgcolor="transparent",pad="0.12",nodesep="0.36",ranksep="0.7",splines=polyline];
node [shape=plain]; edge [color="#687d9a",penwidth=1.45,arrowsize=0.85];
"出版物" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13">&lt;&lt;抽象&gt;&gt;<BR/><I>出版物</I></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 标题 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 基本价格 : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 出版物(标题 : String, 基本价格 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取标题() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取基本价格() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c"><I>+ 计算运费() : int</I></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取总价() : int</FONT></TD></TR></TABLE>>];
"教材" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13"><B>教材</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 页数 : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 教材(标题 : String, 基本价格 : int, 页数 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 计算运费() : int</FONT></TD></TR></TABLE>>];
"杂志" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13"><B>杂志</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 期号 : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 杂志(标题 : String, 基本价格 : int, 期号 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 计算运费() : int</FONT></TD></TR></TABLE>>];
"教材" -> "出版物" [arrowhead=empty];
"杂志" -> "出版物" [arrowhead=empty];
}
