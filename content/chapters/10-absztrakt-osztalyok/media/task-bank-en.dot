digraph UML { graph [rankdir=TB,bgcolor="transparent",pad="0.12",nodesep="0.36",ranksep="0.7",splines=polyline];
node [shape=plain]; edge [color="#687d9a",penwidth=1.45,arrowsize=0.85];
"BankAccount" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">&lt;&lt;abstract&gt;&gt;<BR/><I>BankAccount</I></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- accountNumber : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- balance : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ BankAccount(accountNumber : String, balance : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ getAccountNumber() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ getBalance() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ deposit(amount : int) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ withdraw(amount : int) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c"><I>+ calculateTransferFee(amount : int) : int</I></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ canTransfer(amount : int) : boolean</FONT></TD></TR></TABLE>>];
"SavingsAccount" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13"><B>SavingsAccount</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- monthlyFreeTransfers : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ SavingsAccount(accountNumber : String, balance : int,<BR ALIGN="LEFT"/>    monthlyFreeTransfers : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ calculateTransferFee(amount : int) : int</FONT></TD></TR></TABLE>>];
"BusinessAccount" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13"><B>BusinessAccount</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- feePercent : double</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ BusinessAccount(accountNumber : String, balance : int,<BR ALIGN="LEFT"/>    feePercent : double)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ calculateTransferFee(amount : int) : int</FONT></TD></TR></TABLE>>];
"SavingsAccount" -> "BankAccount" [arrowhead=empty];
"BusinessAccount" -> "BankAccount" [arrowhead=empty];
}
