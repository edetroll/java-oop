digraph UML {
graph [rankdir=TB, bgcolor="transparent", nodesep="0.30", ranksep="0.50", pad="0.12", splines=polyline];
node [shape=plain];
edge [color="#7d8ea6", penwidth=1.1, arrowsize=0.8];
"图书" [label=<<TABLE BORDER="1" COLOR="#94a8c1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#fcfdff"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#e9f1ff"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13" COLOR="#223451"><B>图书</B></FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">- 书号 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">- 标题 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">- 价格 : int</FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 图书(书号 : String, 标题 : String, 价格 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 获取书号() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 获取标题() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 设置标题(数值 : String) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 获取价格() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 设置价格(数值 : int) : void</FONT></TD></TR></TABLE>>];
"价格过低异常" [label=<<TABLE BORDER="1" COLOR="#94a8c1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#fcfdff"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#e9f1ff"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13" COLOR="#223451"><B>价格过低异常</B></FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">- 请求价格 : int</FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 价格过低异常(价格 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 获取请求价格() : int</FONT></TD></TR></TABLE>>];
"价格过高异常" [label=<<TABLE BORDER="1" COLOR="#94a8c1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#fcfdff"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#e9f1ff"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13" COLOR="#223451"><B>价格过高异常</B></FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">- 请求价格 : int</FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 价格过高异常(价格 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 获取请求价格() : int</FONT></TD></TR></TABLE>>];
"书架" [label=<<TABLE BORDER="1" COLOR="#94a8c1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#fcfdff"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#e9f1ff"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13" COLOR="#223451"><B>书架</B></FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">- 图书列表 : ArrayList&lt;图书&gt;</FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 书架()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 添加图书(图书 : 图书) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 获取图书() : List&lt;图书&gt;</FONT></TD></TR></TABLE>>];
"RuntimeException" [shape=plain, label=<<FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12">RuntimeException</FONT>>];
"价格过低异常" -> "RuntimeException" [arrowhead="empty"];
"RuntimeException" [shape=plain, label=<<FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12">RuntimeException</FONT>>];
"价格过高异常" -> "RuntimeException" [arrowhead="empty"];
}