digraph UML {
graph [rankdir=TB, bgcolor="transparent", nodesep="0.30", ranksep="0.50", pad="0.12", splines=polyline];
node [shape=plain];
edge [color="#7d8ea6", penwidth=1.1, arrowsize=0.8];
"场次" [label=<<TABLE BORDER="1" COLOR="#94a8c1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#fcfdff"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#e9f1ff"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13" COLOR="#223451"><B>场次</B></FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">- 电影名称 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">- 场次编号 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">- 容量 : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">- 已订座位 : int</FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 场次(电影名称 : String, 场次编号 : String, 容量 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 获取电影名称() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 获取场次编号() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 获取容量() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 获取已订座位() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 获取空位() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 预订座位(数量 : int) : void</FONT></TD></TR></TABLE>>];
"影院" [label=<<TABLE BORDER="1" COLOR="#94a8c1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#fcfdff"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#e9f1ff"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13" COLOR="#223451"><B>影院</B></FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">- 场次列表 : ArrayList&lt;场次&gt;</FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 影院()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 添加场次(场次 : 场次) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 查找有空位场次(电影名称 : String, 数量 : int) : 场次</FONT></TD></TR></TABLE>>];
"预订无效异常" [label=<<TABLE BORDER="1" COLOR="#94a8c1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#fcfdff"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#e9f1ff"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13" COLOR="#223451"><B>预订无效异常</B></FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"> </TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 预订无效异常(消息 : String)</FONT></TD></TR></TABLE>>];
"座位不足异常" [label=<<TABLE BORDER="1" COLOR="#94a8c1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#fcfdff"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#e9f1ff"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13" COLOR="#223451"><B>座位不足异常</B></FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"> </TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 座位不足异常(消息 : String)</FONT></TD></TR></TABLE>>];
"Exception" [label=<<TABLE BORDER="1" COLOR="#94a8c1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#fcfdff"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#e9f1ff"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13" COLOR="#223451"><B>Exception</B></FONT></TD></TR></TABLE>>];
"预订无效异常" -> "Exception" [arrowhead="empty"];
"座位不足异常" -> "Exception" [arrowhead="empty"];
}
