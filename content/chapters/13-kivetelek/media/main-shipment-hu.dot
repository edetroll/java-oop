digraph UML {
graph [rankdir=TB, bgcolor="transparent", nodesep="0.30", ranksep="0.50", pad="0.12", splines=polyline];
node [shape=plain];
edge [color="#7d8ea6", penwidth=1.1, arrowsize=0.8];
"CourierService" [label=<<TABLE BORDER="1" COLOR="#94a8c1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#fcfdff"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#e9f1ff"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13" COLOR="#223451"><B>CourierService</B></FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"> </TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#263954">+ shipByCourier(weightKg : int) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#263954">+ shipByFreight(weightKg : int) : void</FONT></TD></TR></TABLE>>];
"TooHeavyException" [label=<<TABLE BORDER="1" COLOR="#94a8c1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#fcfdff"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#e9f1ff"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13" COLOR="#223451"><B>TooHeavyException</B></FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"> </TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#263954">+ TooHeavyException(weightKg : int)</FONT></TD></TR></TABLE>>];
"RuntimeException" [shape=plain, label=<<FONT FACE="DejaVu Sans Mono" POINT-SIZE="12">RuntimeException</FONT>>];
"TooHeavyException" -> "RuntimeException" [arrowhead="empty"];
}