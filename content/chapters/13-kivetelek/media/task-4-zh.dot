digraph UML {
graph [rankdir=TB, bgcolor="transparent", nodesep="0.30", ranksep="0.50", pad="0.12", splines=polyline];
node [shape=plain];
edge [color="#7d8ea6", penwidth=1.1, arrowsize=0.8];
"包裹" [label=<<TABLE BORDER="1" COLOR="#94a8c1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#fcfdff"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#e9f1ff"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13" COLOR="#223451"><B>包裹</B></FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">- 包裹编号 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">- 重量公斤 : int</FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 包裹(包裹编号 : String, 重量公斤 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 获取包裹编号() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 获取重量公斤() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 设置重量公斤(数值 : int) : void</FONT></TD></TR></TABLE>>];
"运输中心" [label=<<TABLE BORDER="1" COLOR="#94a8c1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#fcfdff"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#e9f1ff"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13" COLOR="#223451"><B>运输中心</B></FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ {static} COURIER_LIMIT : int = 20</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">- 已寄包裹 : ArrayList&lt;包裹&gt;</FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 运输中心()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 获取已寄包裹() : List&lt;包裹&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 快递寄送(包裹 : 包裹) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 货运寄送(包裹 : 包裹) : void</FONT></TD></TR></TABLE>>];
"包裹超重异常" [label=<<TABLE BORDER="1" COLOR="#94a8c1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#fcfdff"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#e9f1ff"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13" COLOR="#223451"><B>包裹超重异常</B></FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">- 重量公斤 : int</FONT></TD></TR><TR><TD BGCOLOR="#b6c7df" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 包裹超重异常(重量公斤 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#263954">+ 获取重量公斤() : int</FONT></TD></TR></TABLE>>];
"Exception" [label=<<TABLE BORDER="1" COLOR="#94a8c1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#fcfdff"><TR><TD ALIGN="CENTER" CELLPADDING="8" BGCOLOR="#e9f1ff"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13" COLOR="#223451"><B>Exception</B></FONT></TD></TR></TABLE>>];
"包裹超重异常" -> "Exception" [arrowhead="empty"];
}
