digraph UML {
graph [rankdir=BT,bgcolor="transparent",pad="0.15",nodesep="0.3",ranksep="0.6",splines=polyline];
node [shape=plain];
edge [color="#6a819c",penwidth=1.4,arrowsize=0.9];
"矩形" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#90a5c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="14"><B>矩形</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- 横坐标 : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- 纵坐标 : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- 宽度 : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- 高度 : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c"><U>-  创建数量 : int</U></FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 矩形()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 矩形(横坐标 : double, 纵坐标 : double, 宽度 : double, 高度 : double)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+获取横坐标() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+设置横坐标(横坐标 : double) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+获取纵坐标() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+设置纵坐标(纵坐标 : double) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+获取宽度() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+设置宽度(宽度 : double) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+获取高度() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+设置高度(高度 : double) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 计算周长() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 计算面积() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 判断重叠(另一个 : 矩形) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取象限() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c"><U>+  获取创建数量() : int</U></FONT></TD></TR></TABLE>>];
}