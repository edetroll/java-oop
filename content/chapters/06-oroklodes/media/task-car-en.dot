digraph UML {
graph [rankdir=BT, bgcolor="transparent", ranksep="0.75", nodesep="0.38", pad="0.18", splines=polyline];
node [shape=plain];
edge [color="#65768E", penwidth=1.5, arrowsize=1.1, arrowhead=empty];
"Vehicle" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8A98B1" BGCOLOR="#FAFCFF"><TR><TD BGCOLOR="#EAF0FF"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="16" COLOR="#243044"><B>Vehicle</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243044">- manufacturer : String<BR ALIGN="LEFT"/>- maxSpeed : int</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243044">+ getMaxSpeed() : int</FONT></TD></TR></TABLE>>];
"Car" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8A98B1" BGCOLOR="#FAFCFF"><TR><TD BGCOLOR="#EAF0FF"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="16" COLOR="#243044"><B>Car</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243044">- mileage : int</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243044">+ drive(distance) : void</FONT></TD></TR></TABLE>>];
"Motorcycle" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8A98B1" BGCOLOR="#FAFCFF"><TR><TD BGCOLOR="#EAF0FF"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="16" COLOR="#243044"><B>Motorcycle</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243044">- hasSidecar : boolean</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243044">+ getHasSidecar() : boolean</FONT></TD></TR></TABLE>>];
"Car" -> "Vehicle";
"Motorcycle" -> "Vehicle";
}
