digraph UML {
graph [rankdir=TB, bgcolor="transparent", pad="0.10", nodesep="0.50", ranksep="0.55", splines=polyline, overlap=false];
node [shape=plain];
edge [color="#7385a2", penwidth=1.25, arrowsize=0.8];
"Identifiable" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="9" COLOR="#243550">&lt;&lt;interface&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>Identifiable</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ getIdentifier() : String</FONT></TD></TR></TABLE>>];
"Loanable" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="9" COLOR="#243550">&lt;&lt;interface&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>Loanable</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ borrowBook() : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ returnBook() : void</FONT></TD></TR></TABLE>>];
"Book" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>Book</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">- isbn : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">- title : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">- borrowed : boolean</FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ Book(<BR ALIGN="LEFT"/>  isbn : String,<BR ALIGN="LEFT"/>  title : String)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ getIdentifier() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ getTitle() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ isBorrowed() : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ borrowBook() : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ returnBook() : void</FONT></TD></TR></TABLE>>];
"Library" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>Library</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">- books : ArrayList&lt;Book&gt;</FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ Library()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ addBook(book : Book) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ findBook(isbn : String) : Book</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ getAvailableBooks(<BR ALIGN="LEFT"/>  ) : ArrayList&lt;Book&gt;</FONT></TD></TR></TABLE>>];
"Book" -> "Identifiable" [style=dashed,arrowhead=empty];
"Book" -> "Loanable" [style=dashed,arrowhead=empty];
"Library" -> "Book" [dir=back,arrowtail=diamond,arrowhead=none];
}