digraph UML {
graph [rankdir=TB,bgcolor="transparent",pad="0.1",nodesep="0.42",ranksep="0.72",splines=polyline];
node [shape=plain]; edge [color="#627a9d",penwidth=1.4,arrowsize=0.85];
"Iterable<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12"><B>&lt;&lt;interface&gt;&gt;<BR/>Iterable&lt;T&gt;</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c"> </FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ iterator() : Iterator&lt;T&gt;</FONT></TD></TR></TABLE>>];
"Collection<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12"><B>&lt;&lt;interface&gt;&gt;<BR/>Collection&lt;T&gt;</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c"> </FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ size() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ add(value : T) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ contains(value : Object) : boolean</FONT></TD></TR></TABLE>>];
"List<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12"><B>&lt;&lt;interface&gt;&gt;<BR/>List&lt;T&gt;</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c"> </FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ get(index : int) : T</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ set(index : int, value : T) : T</FONT></TD></TR></TABLE>>];
"ArrayList<T>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12"><B>ArrayList&lt;T&gt;</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c"> </FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ ArrayList()</FONT></TD></TR></TABLE>>];
"Collection<T>" -> "Iterable<T>" [style=solid,arrowhead=empty];
"List<T>" -> "Collection<T>" [style=solid,arrowhead=empty];
"ArrayList<T>" -> "List<T>" [style=dashed,arrowhead=empty];
}
