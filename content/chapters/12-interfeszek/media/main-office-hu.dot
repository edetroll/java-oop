digraph UML {
graph [rankdir=TB,bgcolor="transparent",pad="0.1",nodesep="0.42",ranksep="0.72",splines=polyline];
node [shape=plain]; edge [color="#627a9d",penwidth=1.4,arrowsize=0.85];
"Document" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12"><B>Document</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- title : String</FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ Document(title : String)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ getTitle() : String</FONT></TD></TR></TABLE>>];
"Printable" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12"><B>&lt;&lt;interface&gt;&gt;<BR/>Printable</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c"> </FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ printDocument(document : Document) : void</FONT></TD></TR></TABLE>>];
"Scannable" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12"><B>&lt;&lt;interface&gt;&gt;<BR/>Scannable</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c"> </FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ scanDocument(sourceTitle : String) : Document</FONT></TD></TR></TABLE>>];
"DeskPrinter" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12"><B>DeskPrinter</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c"> </FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ printDocument(document : Document) : void</FONT></TD></TR></TABLE>>];
"MultifunctionDevice" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12"><B>MultifunctionDevice</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c"> </FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ printDocument(document : Document) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ scanDocument(sourceTitle : String) : Document</FONT></TD></TR></TABLE>>];
"OfficeWorkflow" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12"><B>OfficeWorkflow</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- printer : Printable</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- scanner : Scannable</FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ OfficeWorkflow(printer : Printable, scanner : Scannable)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ copyDocument(sourceTitle : String) : void</FONT></TD></TR></TABLE>>];
"DeskPrinter" -> "Printable" [style=dashed,arrowhead=empty];
"MultifunctionDevice" -> "Printable" [style=dashed,arrowhead=empty];
"MultifunctionDevice" -> "Scannable" [style=dashed,arrowhead=empty];
"OfficeWorkflow" -> "Printable" [style=dotted,arrowhead=vee];
"OfficeWorkflow" -> "Scannable" [style=dotted,arrowhead=vee];
}
