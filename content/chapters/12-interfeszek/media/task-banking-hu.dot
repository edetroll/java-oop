digraph UML {
graph [rankdir=TB, bgcolor="transparent", pad="0.10", nodesep="0.50", ranksep="0.55", splines=polyline, overlap=false];
node [shape=plain];
edge [color="#7385a2", penwidth=1.25, arrowsize=0.8];
"Payable" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="9" COLOR="#243550">&lt;&lt;interface&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>Payable</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ pay(amount : int) : boolean</FONT></TD></TR></TABLE>>];
"Refundable" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="9" COLOR="#243550">&lt;&lt;interface&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>Refundable</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ refund(amount : int) : boolean</FONT></TD></TR></TABLE>>];
"PaymentMethod" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><I><B>PaymentMethod</B></I></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">- balance : int</FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550"># PaymentMethod(balance : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ getBalance() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550"># withdraw(amount : int) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550"># deposit(amount : int) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550"><I>+ pay(amount : int) : boolean</I></FONT></TD></TR></TABLE>>];
"BankTransfer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>BankTransfer</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ BankTransfer(balance : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ pay(amount : int) : boolean</FONT></TD></TR></TABLE>>];
"CardPayment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>CardPayment</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">- lastPaidAmount : int</FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ CardPayment(balance : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ pay(amount : int) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ refund(amount : int) : boolean</FONT></TD></TR></TABLE>>];
"CheckoutService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>CheckoutService</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ CheckoutService()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ checkout(<BR ALIGN="LEFT"/>  method : Payable,<BR ALIGN="LEFT"/>  amount : int) : boolean</FONT></TD></TR></TABLE>>];
"PaymentMethod" -> "Payable" [style=dashed,arrowhead=empty];
"BankTransfer" -> "PaymentMethod" [arrowhead=empty];
"CardPayment" -> "PaymentMethod" [arrowhead=empty];
"CardPayment" -> "Refundable" [style=dashed,arrowhead=empty];
"CheckoutService" -> "Payable" [style=dotted,arrowhead=vee];
}