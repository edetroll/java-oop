digraph UML {
graph [rankdir=TB, bgcolor="transparent", pad="0.10", nodesep="0.50", ranksep="0.55", splines=polyline, overlap=false];
node [shape=plain];
edge [color="#7385a2", penwidth=1.25, arrowsize=0.8];
"Comparable<订单>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="9" COLOR="#243550">&lt;&lt;interface&gt;&gt;</FONT><BR/><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12" COLOR="#243550"><B>Comparable&lt;订单&gt;</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ compareTo(其他订单 : 订单) : int</FONT></TD></TR></TABLE>>];
"Comparator<订单>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="9" COLOR="#243550">&lt;&lt;interface&gt;&gt;</FONT><BR/><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12" COLOR="#243550"><B>Comparator&lt;订单&gt;</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ compare(<BR ALIGN="LEFT"/>  第一项 : 订单,<BR ALIGN="LEFT"/>  第二项 : 订单) : int</FONT></TD></TR></TABLE>>];
"Iterable<订单>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="9" COLOR="#243550">&lt;&lt;interface&gt;&gt;</FONT><BR/><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12" COLOR="#243550"><B>Iterable&lt;订单&gt;</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ iterator() : Iterator&lt;订单&gt;</FONT></TD></TR></TABLE>>];
"订单" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12" COLOR="#243550"><B>订单</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">- 编号 : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">- 金额 : int</FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 订单(编号 : int, 金额 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 获取编号() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 获取金额() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ compareTo(其他订单 : 订单) : int</FONT></TD></TR></TABLE>>];
"订单编号比较器" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12" COLOR="#243550"><B>订单编号比较器</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 订单编号比较器()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ compare(<BR ALIGN="LEFT"/>  第一项 : 订单,<BR ALIGN="LEFT"/>  第二项 : 订单) : int</FONT></TD></TR></TABLE>>];
"订单登记簿" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12" COLOR="#243550"><B>订单登记簿</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">- 订单列表 : ArrayList&lt;订单&gt;</FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 订单登记簿()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 添加订单(order : 订单) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ iterator() : Iterator&lt;订单&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 按金额排序() : ArrayList&lt;订单&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 按编号排序() : ArrayList&lt;订单&gt;</FONT></TD></TR></TABLE>>];
