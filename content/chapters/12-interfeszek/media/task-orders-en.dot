digraph UML {
graph [rankdir=TB, bgcolor="transparent", pad="0.10", nodesep="0.50", ranksep="0.55", splines=polyline, overlap=false];
node [shape=plain];
edge [color="#7385a2", penwidth=1.25, arrowsize=0.8];
"Comparable<Order>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="9" COLOR="#243550">&lt;&lt;interface&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>Comparable&lt;Order&gt;</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ compareTo(other : Order) : int</FONT></TD></TR></TABLE>>];
"Comparator<Order>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="9" COLOR="#243550">&lt;&lt;interface&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>Comparator&lt;Order&gt;</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ compare(<BR ALIGN="LEFT"/>  first : Order,<BR ALIGN="LEFT"/>  second : Order) : int</FONT></TD></TR></TABLE>>];
"Iterable<Order>" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="9" COLOR="#243550">&lt;&lt;interface&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>Iterable&lt;Order&gt;</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ iterator() : Iterator&lt;Order&gt;</FONT></TD></TR></TABLE>>];
"Order" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>Order</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">- id : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">- amount : int</FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ Order(id : int, amount : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ getId() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ getAmount() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ compareTo(other : Order) : int</FONT></TD></TR></TABLE>>];
"OrderIdComparator" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>OrderIdComparator</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ OrderIdComparator()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ compare(<BR ALIGN="LEFT"/>  first : Order,<BR ALIGN="LEFT"/>  second : Order) : int</FONT></TD></TR></TABLE>>];
"OrderRegister" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>OrderRegister</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">- orders : ArrayList&lt;Order&gt;</FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ OrderRegister()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ addOrder(order : Order) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ iterator() : Iterator&lt;Order&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ getOrderedByAmount(<BR ALIGN="LEFT"/>  ) : ArrayList&lt;Order&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ getOrderedById(<BR ALIGN="LEFT"/>  ) : ArrayList&lt;Order&gt;</FONT></TD></TR></TABLE>>];
"Order" -> "Comparable<Order>" [style=dashed,arrowhead=empty];
"OrderIdComparator" -> "Comparator<Order>" [style=dashed,arrowhead=empty];
"OrderRegister" -> "Iterable<Order>" [style=dashed,arrowhead=empty];
"OrderRegister" -> "Order" [dir=back,arrowtail=diamond,arrowhead=none];
}