digraph UML {
graph [rankdir=TB,bgcolor="transparent",pad="0.1",nodesep="0.42",ranksep="0.72",splines=polyline];
node [shape=plain]; edge [color="#627a9d",penwidth=1.4,arrowsize=0.85];
"Document" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12"><B>文档</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 标题 : String</FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 文档(标题 : String)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取标题() : String</FONT></TD></TR></TABLE>>];
"Printable" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12"><B>&lt;&lt;interface&gt;&gt;<BR/>可打印</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c"> </FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 打印文档(文档对象 : 文档) : void</FONT></TD></TR></TABLE>>];
"Scannable" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12"><B>&lt;&lt;interface&gt;&gt;<BR/>可扫描</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c"> </FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 扫描文档(来源标题 : String) : 文档</FONT></TD></TR></TABLE>>];
"DeskPrinter" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12"><B>桌面打印机</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c"> </FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 打印文档(文档对象 : 文档) : void</FONT></TD></TR></TABLE>>];
"MultifunctionDevice" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12"><B>多功能设备</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c"> </FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 打印文档(文档对象 : 文档) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 扫描文档(来源标题 : String) : 文档</FONT></TD></TR></TABLE>>];
"OfficeWorkflow" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12"><B>办公流程</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 打印设备 : 可打印</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 扫描设备 : 可扫描</FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 办公流程(打印设备 : 可打印, 扫描设备 : 可扫描)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 复制文档(来源标题 : String) : void</FONT></TD></TR></TABLE>>];
"DeskPrinter" -> "Printable" [style=dashed,arrowhead=empty];
"MultifunctionDevice" -> "Printable" [style=dashed,arrowhead=empty];
"MultifunctionDevice" -> "Scannable" [style=dashed,arrowhead=empty];
"OfficeWorkflow" -> "Printable" [style=dotted,arrowhead=vee];
"OfficeWorkflow" -> "Scannable" [style=dotted,arrowhead=vee];
}
