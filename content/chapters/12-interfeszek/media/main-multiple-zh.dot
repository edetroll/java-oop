digraph UML {
graph [rankdir=TB,bgcolor="transparent",pad="0.1",nodesep="0.42",ranksep="0.72",splines=polyline];
node [shape=plain]; edge [color="#627a9d",penwidth=1.4,arrowsize=0.85];
"OfficeDevice" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12"><B>&lt;&lt;abstract&gt;&gt;<BR/><I>办公设备</I></B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c"># 序列号 : String</FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c"># 办公设备(序列号 : String)</FONT></TD></TR></TABLE>>];
"Printable" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12"><B>&lt;&lt;interface&gt;&gt;<BR/>可打印</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c"> </FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 打印文档(文档对象 : 文档) : void</FONT></TD></TR></TABLE>>];
"Scannable" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12"><B>&lt;&lt;interface&gt;&gt;<BR/>可扫描</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c"> </FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 扫描文档(来源标题 : String) : 文档</FONT></TD></TR></TABLE>>];
"NetworkMachine" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD ALIGN="CENTER" BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12"><B>网络设备</B></FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c"> </FONT></TD></TR><TR><TD BGCOLOR="#c9d4e3" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 网络设备(序列号 : String)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 打印文档(文档对象 : 文档) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 扫描文档(来源标题 : String) : 文档</FONT></TD></TR></TABLE>>];
"NetworkMachine" -> "OfficeDevice" [style=solid,arrowhead=empty];
"NetworkMachine" -> "Printable" [style=dashed,arrowhead=empty];
"NetworkMachine" -> "Scannable" [style=dashed,arrowhead=empty];
}
