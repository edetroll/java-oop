digraph UML {
graph [rankdir=TB, bgcolor="transparent", pad="0.10", nodesep="0.50", ranksep="0.55", splines=polyline, overlap=false];
node [shape=plain];
edge [color="#7385a2", penwidth=1.25, arrowsize=0.8];
"Document" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>Document</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">- title : String</FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ Document(title : String)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ getTitle() : String</FONT></TD></TR></TABLE>>];
"Printable" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="9" COLOR="#243550">&lt;&lt;interface&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>Printable</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ printDocument(<BR ALIGN="LEFT"/>  document : Document) : void</FONT></TD></TR></TABLE>>];
"Scannable" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="9" COLOR="#243550">&lt;&lt;interface&gt;&gt;</FONT><BR/><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>Scannable</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ scanDocument(<BR ALIGN="LEFT"/>  title : String) : Document</FONT></TD></TR></TABLE>>];
"SimplePrinter" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>SimplePrinter</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">- completedJobs : int</FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ SimplePrinter()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ printDocument(<BR ALIGN="LEFT"/>  document : Document) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ getCompletedJobs() : int</FONT></TD></TR></TABLE>>];
"MultifunctionDevice" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>MultifunctionDevice</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">- completedJobs : int</FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ MultifunctionDevice()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ printDocument(<BR ALIGN="LEFT"/>  document : Document) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ scanDocument(<BR ALIGN="LEFT"/>  title : String) : Document</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ getCompletedJobs() : int</FONT></TD></TR></TABLE>>];
"CopyService" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12" COLOR="#243550"><B>CopyService</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">- printer : Printable</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">- scanner : Scannable</FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ CopyService(<BR ALIGN="LEFT"/>  printer : Printable,<BR ALIGN="LEFT"/>  scanner : Scannable)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#243550">+ copy(title : String) : void</FONT></TD></TR></TABLE>>];
"SimplePrinter" -> "Printable" [style=dashed,arrowhead=empty];
"MultifunctionDevice" -> "Printable" [style=dashed,arrowhead=empty];
"MultifunctionDevice" -> "Scannable" [style=dashed,arrowhead=empty];
"CopyService" -> "Printable" [style=dotted,arrowhead=vee];
"CopyService" -> "Scannable" [style=dotted,arrowhead=vee];
}