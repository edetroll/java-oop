digraph UML {
graph [rankdir=TB, bgcolor="transparent", pad="0.10", nodesep="0.50", ranksep="0.55", splines=polyline, overlap=false];
node [shape=plain];
edge [color="#7385a2", penwidth=1.25, arrowsize=0.8];
"可支付" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="9" COLOR="#243550">&lt;&lt;interface&gt;&gt;</FONT><BR/><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12" COLOR="#243550"><B>可支付</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 支付(金额 : int) : boolean</FONT></TD></TR></TABLE>>];
"可退款" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="9" COLOR="#243550">&lt;&lt;interface&gt;&gt;</FONT><BR/><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12" COLOR="#243550"><B>可退款</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 退款(金额 : int) : boolean</FONT></TD></TR></TABLE>>];
"支付方式" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12" COLOR="#243550"><I><B>支付方式</B></I></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">- 余额 : int</FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550"># 支付方式(余额 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 获取余额() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550"># 取款(金额 : int) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550"># 存款(金额 : int) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550"><I>+ 支付(金额 : int) : boolean</I></FONT></TD></TR></TABLE>>];
"银行转账" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12" COLOR="#243550"><B>银行转账</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 银行转账(余额 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 支付(金额 : int) : boolean</FONT></TD></TR></TABLE>>];
"银行卡支付" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12" COLOR="#243550"><B>银行卡支付</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">- 上次支付金额 : int</FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 银行卡支付(余额 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 支付(金额 : int) : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 退款(金额 : int) : boolean</FONT></TD></TR></TABLE>>];
"结算服务" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#96a9c5" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e9f0ff" ALIGN="CENTER" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12" COLOR="#243550"><B>结算服务</B></FONT></TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"> </TD></TR><TR><TD BGCOLOR="#c8d4e4" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 结算服务()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#243550">+ 结算(方式 : 可支付, 金额 : int) : boolean</FONT></TD></TR></TABLE>>];
"支付方式" -> "可支付" [style=dashed,arrowhead=empty];
"银行转账" -> "支付方式" [arrowhead=empty];
"银行卡支付" -> "支付方式" [arrowhead=empty];
"银行卡支付" -> "可退款" [style=dashed,arrowhead=empty];
"结算服务" -> "可支付" [style=dotted,arrowhead=vee];
}