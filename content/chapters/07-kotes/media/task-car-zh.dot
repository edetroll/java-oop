digraph UML {
graph [rankdir=BT, bgcolor="transparent", pad="0.20", nodesep="0.53", ranksep="0.90", splines="polyline"];
node [shape=plain, fontname="Noto Sans Mono CJK SC"];
edge [颜色="#5c7192", penwidth=1.5, arrowsize=1.15];
vehicle [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#aab8d0" BGCOLOR="#fbfcff"><TR><TD BGCOLOR="#e7efff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="14"><B>交通工具</B></FONT></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="11">- 制造商: String</FONT></TD></TR><TR><TD BGCOLOR="#d7dfed" HEIGHT="2"></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="11">+ 获取续航(): double</FONT></TD></TR></TABLE>>];
car [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#aab8d0" BGCOLOR="#fbfcff"><TR><TD BGCOLOR="#e7efff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="14"><B>汽车</B></FONT></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="11">- 油箱容量: double</FONT></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="11">- 百公里油耗: double</FONT></TD></TR><TR><TD BGCOLOR="#d7dfed" HEIGHT="2"></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="11">+ 获取续航(): double</FONT></TD></TR></TABLE>>];
moto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#aab8d0" BGCOLOR="#fbfcff"><TR><TD BGCOLOR="#e7efff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="14"><B>摩托车</B></FONT></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="11">- 油箱容量: double</FONT></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="11">- 百公里油耗: double</FONT></TD></TR><TR><TD BGCOLOR="#d7dfed" HEIGHT="2"></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="11">+ 获取续航(): double</FONT></TD></TR></TABLE>>];
car -> vehicle [arrowhead=empty];
moto -> vehicle [arrowhead=empty];
}