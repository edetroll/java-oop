digraph UML {
graph [rankdir=BT, bgcolor="transparent", pad="0.20", nodesep="0.53", ranksep="0.90", splines="polyline"];
node [shape=plain, fontname="DejaVu Sans Mono"];
edge [color="#5c7192", penwidth=1.5, arrowsize=1.15];
media [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#aab8d0" BGCOLOR="#fbfcff"><TR><TD BGCOLOR="#e7efff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14"><B>MediaItem</B></FONT></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">- title: String</FONT></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">- year: int</FONT></TD></TR><TR><TD BGCOLOR="#d7dfed" HEIGHT="2"></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">+ getDescription(): String</FONT></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">+ printDescription(): void</FONT></TD></TR></TABLE>>];
movie [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#aab8d0" BGCOLOR="#fbfcff"><TR><TD BGCOLOR="#e7efff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14"><B>Movie</B></FONT></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">- durationMinutes: int</FONT></TD></TR><TR><TD BGCOLOR="#d7dfed" HEIGHT="2"></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">+ getDescription(): String</FONT></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">+ getDescription(boolean): String</FONT></TD></TR></TABLE>>];
series [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#aab8d0" BGCOLOR="#fbfcff"><TR><TD BGCOLOR="#e7efff" CELLPADDING="8"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="14"><B>Series</B></FONT></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">- seasons: int</FONT></TD></TR><TR><TD BGCOLOR="#d7dfed" HEIGHT="2"></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="11">+ getDescription(): String</FONT></TD></TR></TABLE>>];
movie -> media [arrowhead=empty];
series -> media [arrowhead=empty];
}