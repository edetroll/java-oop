digraph UML {
graph [rankdir=BT, bgcolor="transparent", pad="0.20", nodesep="0.53", ranksep="0.90", splines="polyline"];
node [shape=plain, fontname="Noto Sans Mono CJK SC"];
edge [颜色="#5c7192", penwidth=1.5, arrowsize=1.15];
shape [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#aab8d0" BGCOLOR="#fbfcff"><TR><TD BGCOLOR="#e7efff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="14"><B>图形</B></FONT></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="11">- 颜色: String</FONT></TD></TR><TR><TD BGCOLOR="#d7dfed" HEIGHT="2"></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="11">+ 获取描述(): String</FONT></TD></TR></TABLE>>];
rectangle [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#aab8d0" BGCOLOR="#fbfcff"><TR><TD BGCOLOR="#e7efff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="14"><B>矩形</B></FONT></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="11">- 宽度: double</FONT></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="11">- 高度: double</FONT></TD></TR><TR><TD BGCOLOR="#d7dfed" HEIGHT="2"></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="11">+ 获取描述(): String</FONT></TD></TR></TABLE>>];
circle [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#aab8d0" BGCOLOR="#fbfcff"><TR><TD BGCOLOR="#e7efff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="14"><B>圆形</B></FONT></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="11">- 半径: double</FONT></TD></TR><TR><TD BGCOLOR="#d7dfed" HEIGHT="2"></TD></TR><TR><TD BGCOLOR="#fbfcff" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="11">+ 获取描述(): String</FONT></TD></TR></TABLE>>];
rectangle -> shape [arrowhead=empty];
circle -> shape [arrowhead=empty];
}