digraph UML {
graph [rankdir=BT,bgcolor="transparent",pad="0.15",nodesep="0.4",ranksep="0.75",splines=polyline];
node [shape=plain];
edge [color="#6a819c",penwidth=1.4,arrowsize=0.9];
"银行账户" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#90a5c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="14"><B>银行账户</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 持有人 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 账号 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 余额 : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取余额() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 存款(金额 : int) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 取款(金额 : int) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 计算转账手续费(金额 : int) : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 能否支付转账(金额 : int) : boolean</FONT></TD></TR></TABLE>>];
"储蓄账户" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#90a5c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="14"><B>储蓄账户</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 利率 : double</FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取利率() : double</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 设置利率(利率 : double) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 计算转账手续费(金额 : int) : int</FONT></TD></TR></TABLE>>];
"企业账户" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#90a5c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="14"><B>企业账户</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 公司名 : String</FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取公司名() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 设置公司名(公司名 : String) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 计算转账手续费(金额 : int) : int</FONT></TD></TR></TABLE>>];
"储蓄账户" -> "银行账户" [arrowhead=empty];
"企业账户" -> "银行账户" [arrowhead=empty];
}
