digraph UML { graph [rankdir=TB,bgcolor="transparent",pad="0.12",nodesep="0.36",ranksep="0.7",splines=polyline];
node [shape=plain]; edge [color="#687d9a",penwidth=1.45,arrowsize=0.85];
"Garage" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13"><B>Garage</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- name : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- hourlyRate : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ Garage(name : String, hourlyRate : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ getName() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ getHourlyRate() : int</FONT></TD></TR></TABLE>>];
"Garage.ServiceTicket" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="13">&lt;&lt;public inner&gt;&gt;<BR/><B>Garage.ServiceTicket</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">- hours : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ ServiceTicket(hours : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="DejaVu Sans Mono" POINT-SIZE="10" COLOR="#27364c">+ calculateCost() : int</FONT></TD></TR></TABLE>>];
"Garage" -> "Garage.ServiceTicket" [style=dashed,arrowhead=vee];
}
