digraph UML { graph [rankdir=TB,bgcolor="transparent",pad="0.12",nodesep="0.36",ranksep="0.7",splines=polyline];
node [shape=plain]; edge [color="#687d9a",penwidth=1.45,arrowsize=0.85];
"图书馆" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13"><B>图书馆</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 借阅列表 : ArrayList&lt;借阅记录&gt;</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 图书馆()</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 添加借阅(图书编号 : String, 借阅天数 : int) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 统计逾期(允许天数 : int) : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 获取借阅数量() : int</FONT></TD></TR></TABLE>>];
"图书馆.借阅记录" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13">&lt;&lt;私有静态嵌套&gt;&gt;<BR/><B>图书馆.借阅记录</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 图书编号 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 借阅天数 : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 借阅记录(图书编号 : String, 借阅天数 : int)</FONT></TD></TR></TABLE>>];
"图书馆" -> "图书馆.借阅记录" [style=dashed,arrowhead=vee];
}
