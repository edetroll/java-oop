digraph UML { graph [rankdir=TB,bgcolor="transparent",pad="0.12",nodesep="0.36",ranksep="0.7",splines=polyline];
node [shape=plain]; edge [color="#687d9a",penwidth=1.45,arrowsize=0.85];
"车库" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13"><B>车库</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 服务单价 : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 车库(服务单价 : int)</FONT></TD></TR></TABLE>>];
"车库.维修单" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#91a7c3" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="7"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13">&lt;&lt;非静态内部类&gt;&gt;<BR/><B>车库.维修单</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">- 工时 : int</FONT></TD></TR><TR><TD BGCOLOR="#e1e7f0" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 维修单(工时 : int)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 计算费用() : int</FONT></TD></TR></TABLE>>];
"车库" -> "车库.维修单" [style=dashed,arrowhead=vee];
}
