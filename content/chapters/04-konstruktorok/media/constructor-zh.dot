digraph G {
 graph [bgcolor="transparent",margin=0,pad=0.04];
 node [fontname="Liberation Mono",fontsize=12,shape=plain];
 uml [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a98b1" BGCOLOR="#fafcff">
<TR><TD BGCOLOR="#eaf0ff" CELLPADDING="10"><FONT FACE="Liberation Mono" POINT-SIZE="16"><B>学生</B></FONT></TD></TR>
<HR/>
<TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="Liberation Mono" POINT-SIZE="12">- 姓名 : String</FONT></TD></TR>
<HR/>
<TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 学生()</FONT></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 学生(姓名 : String)</FONT></TD></TR>
</TABLE>>];
}
