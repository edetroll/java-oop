digraph G {
 graph [bgcolor="transparent",margin=0,pad=0.04];
 node [fontname="Liberation Mono",fontsize=12,shape=plain];
 uml [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a98b1" BGCOLOR="#fafcff">
<TR><TD BGCOLOR="#eaf0ff" CELLPADDING="10"><FONT FACE="Liberation Mono" POINT-SIZE="16"><B>汽车</B></FONT></TD></TR>
<HR/>
<TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="Liberation Mono" POINT-SIZE="12">- 品牌 : String</FONT></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="Liberation Mono" POINT-SIZE="12">- 型号 : String</FONT></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="Liberation Mono" POINT-SIZE="12">- 生产年份 : int</FONT></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="Liberation Mono" POINT-SIZE="12">- 里程 : double</FONT></TD></TR>
<HR/>
<TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 汽车(品牌, 型号, 年份)</FONT></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6"><FONT FACE="Liberation Mono" POINT-SIZE="12">+ 汽车(品牌, 型号, 年份, 里程)</FONT></TD></TR>
</TABLE>>];
}
