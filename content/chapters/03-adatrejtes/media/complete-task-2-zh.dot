digraph UML {
graph [rankdir=BT,bgcolor="transparent",pad="0.15",nodesep="0.3",ranksep="0.6",splines=polyline];
node [shape=plain];
edge [color="#6a819c",penwidth=1.4,arrowsize=0.9];
"图书" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#90a5c0" BGCOLOR="#fbfdff"><TR><TD BGCOLOR="#e8eeff" CELLPADDING="8"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="14"><B>图书</B></FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- 作者 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- 标题 : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- 价格 : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- 类别 : 类别</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">- 纸质 : boolean</FONT></TD></TR><TR><TD BGCOLOR="#e1e6ef" HEIGHT="2"></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+获取作者() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+设置作者(作者 : String) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+获取标题() : String</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+设置标题(标题 : String) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+获取价格() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+设置价格(价格 : int) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+获取类别() : 类别</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+设置类别(类别 : 类别) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+是否纸质() : boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+设置纸质(纸质 : boolean) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ 打折(百分比 : int) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Noto Sans CJK SC" POINT-SIZE="10" COLOR="#27364c">+ toString() : String</FONT></TD></TR></TABLE>>];
}