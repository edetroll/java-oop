digraph G { graph [bgcolor="transparent",pad="0.05"]; node [shape=plaintext,fontname="DejaVu Sans",fontsize=12]; a [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#a0adc2" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#e8eefc"><B>Rectangle</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- x : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- y : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- width : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- height : double</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setWidth(value : double) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setHeight(value : double) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ perimeter() : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ area() : double</TD></TR></TABLE>>]; }