digraph G { graph [bgcolor="transparent",pad="0.05"]; node [shape=plaintext,fontname="Liberation Mono",fontsize=12]; a [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#a0adc2" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#e8eefc"><FONT FACE="Liberation Mono" POINT-SIZE="16"><B>Film</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- director : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- title : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- actors : List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- categories : List&lt;Category&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- duration : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- language : Language</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addActor(name : String) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getActors() : List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addCategory(c : Category) : void</TD></TR></TABLE>>]; }