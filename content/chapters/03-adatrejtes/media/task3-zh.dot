digraph G { graph [bgcolor="transparent",pad="0.05"]; node [shape=plaintext,fontname="Liberation Mono",fontsize=12]; a [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#a0adc2" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#e8eefc"><FONT FACE="Liberation Mono" POINT-SIZE="16"><B>电影</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 导演 : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 片名 : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 演员 : List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 分类 : List&lt;类别&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 时长 : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 语言 : 语言</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ 添加演员(姓名 : String) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ 获取演员() : List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ 添加类别(分类 : 类别) : void</TD></TR></TABLE>>]; }