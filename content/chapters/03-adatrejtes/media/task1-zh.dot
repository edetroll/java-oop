digraph G { graph [bgcolor="transparent",pad="0.05"]; node [shape=plaintext,fontname="DejaVu Sans",fontsize=12]; a [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#a0adc2" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#e8eefc"><B>矩形</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 横坐标 : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 纵坐标 : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 宽度 : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 高度 : double</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ 设置宽度(值 : double) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ 设置高度(值 : double) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ 周长() : double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ 面积() : double</TD></TR></TABLE>>]; }