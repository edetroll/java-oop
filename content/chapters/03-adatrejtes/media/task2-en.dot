digraph G { graph [bgcolor="transparent",pad="0.05"]; node [shape=plaintext,fontname="DejaVu Sans",fontsize=12]; a [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#a0adc2" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#e8eefc"><B>Book</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- author : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- title : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- price : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- genre : Genre</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- printed : boolean</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setPrice(value : int) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getPrice() : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ discount(percent : int) : void</TD></TR></TABLE>>]; }