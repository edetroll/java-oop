digraph G { graph [bgcolor="transparent",pad="0.05"]; node [shape=plaintext,fontname="DejaVu Sans",fontsize=12]; a [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#a0adc2" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#e8eefc"><B>图书</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 作者 : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 书名 : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 价格 : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 类别 : 类别枚举</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- 纸质版 : boolean</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ 设置价格(值 : int) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ 获取价格() : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ 打折(百分比 : int) : void</TD></TR></TABLE>>]; }