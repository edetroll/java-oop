digraph G { graph [bgcolor="transparent",pad="0.05"]; node [shape=plaintext,fontname="DejaVu Sans",fontsize=12]; a [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#a0adc2" BGCOLOR="#f8fafc"><TR><TD BGCOLOR="#e8eefc"><B>Film</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- rendezo : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- cim : String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- szereplok : List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- kategoriak : List&lt;Kategoria&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- hossz : int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nyelv : Nyelv</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ szereploHozzaadasa(nev : String) : void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getSzereplok() : List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ kategoriaHozzaadasa(k : Kategoria) : void</TD></TR></TABLE>>]; }